# Copy to .env.local (gitignored) and fill in. Never commit real values.

# "dev"      = LOCAL DEMO: plain local Postgres + dev sign-in bypass (no email verification)
# "supabase" = Supabase Auth email OTP (requires the two NEXT_PUBLIC_SUPABASE_* values)
LERNE_AUTH_MODE=dev

# Postgres connection used by the server for all queries (each runs as role
# `authenticated` with RLS). Local: a database on your machine. Supabase: the
# project's direct / session-pooler connection string (Settings → Database).
DATABASE_URL=postgresql://localhost:5432/lerne_dev

# Dev mode only: signs the dev-bypass session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LERNE_SESSION_SECRET=replace-with-64-hex-chars

# Supabase mode only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
